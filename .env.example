# Société local development environment
# Copy to .env and adjust. Never commit .env.

APP_NAME=societe-api
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Auth — local JWT is development-only. Startup fails if AUTH_PROVIDER=local
# when APP_ENV is staging or production.
AUTH_PROVIDER=local
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
LOCAL_DEV_SUBJECT=local-dev-user
LOCAL_DEV_HANDLE=localdev

# Cognito adapter (unused when AUTH_PROVIDER=local). No Cognito resources in Phase 1.
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ACCEPT_ID_TOKENS=false

# Signed map cursors — generate with: openssl rand -hex 32
CURSOR_HMAC_SECRET=replace-me-cursor-hmac
CURSOR_TTL_SECONDS=1800
VENUE_STATIC_CACHE_TTL_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=86400

DATABASE_URL=postgresql+asyncpg://societe:societe@localhost:5432/societe
VALKEY_URL=redis://localhost:6379/0

MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=societe
MINIO_ROOT_PASSWORD=societe-minio-dev
MINIO_BUCKET=societe-local

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025

OTEL_ENABLED=false
OTEL_SERVICE_NAME=societe-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags (Phase 0 defaults)
FF_LIVE_CROWD_COUNTS=false
FF_CALLING_CARDS=false
FF_VENUE_PEOPLE_DISCOVERY=false
FF_QR_VERIFICATION=false
FF_BLE_VERIFICATION=false
FF_MEDIA_POSTING=false
FF_AUTOMATED_MODERATION=false
FF_GHOST_MODE=true

# Pinned local dependency images (documented in docs/dependency-upgrades.md)
POSTGRES_IMAGE=postgis/postgis:16-3.5
VALKEY_IMAGE=valkey/valkey:8.1.9
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MAILPIT_IMAGE=axllent/mailpit:v1.30.5
API_PYTHON_IMAGE=python:3.12.13-slim-bookworm
