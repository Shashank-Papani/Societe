# Société local development environment
# Copy to .env and adjust. Never commit .env.

APP_NAME=societe-api
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Auth — local JWT is development-only. Startup fails if AUTH_PROVIDER=local
# when APP_ENV is staging or production.
AUTH_PROVIDER=local
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
LOCAL_DEV_SUBJECT=local-dev-user
LOCAL_DEV_HANDLE=localdev

# Cognito adapter (unused when AUTH_PROVIDER=local). No Cognito resources in Phase 1.
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ACCEPT_ID_TOKENS=false

# Signed map cursors — generate with: openssl rand -hex 32
CURSOR_HMAC_SECRET=replace-me-cursor-hmac
CURSOR_TTL_SECONDS=1800
VENUE_STATIC_CACHE_TTL_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=86400

# Presence (Phase 2). Server time is authoritative; OBSERVED_AT only gates
# freshness and clock skew.
MAX_EVIDENCE_AGE_SECONDS=15
MAX_OBSERVED_FUTURE_SKEW_SECONDS=5
PRESENCE_CANDIDATE_RADIUS_M=150
VERIFIED_LEASE_SECONDS=120
DEGRADED_GRACE_SECONDS=300
EVIDENCE_IDEMPOTENCY_TTL_SECONDS=900
LOCATION_RATE_LIMIT_PER_USER_PER_MINUTE=20
LOCATION_RATE_LIMIT_PER_DEVICE_PER_MINUTE=20
PRESENCE_SAMPLE_BUFFER_MAX=12
PRESENCE_SAMPLE_BUFFER_TTL_SECONDS=120
EVIDENCE_ABSOLUTE_MAX_RETENTION_HOURS=36
# Used for evidence purge deadlines when no venue was resolved.
DEFAULT_PURGE_TIMEZONE=America/Los_Angeles

DATABASE_URL=postgresql+asyncpg://societe:societe@localhost:5432/societe
VALKEY_URL=redis://localhost:6379/0

# Internal endpoint the API and workers dial. Compose overrides this with
# http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
# Client-reachable endpoint used for every presigned URL. A device cannot resolve
# the Compose hostname, so this must never be http://minio:9000.
#   iOS simulator ......... http://localhost:9000
#   Android emulator ...... http://10.0.2.2:9000
#   Physical device ....... http://<your-LAN-ip>:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ROOT_USER=societe
MINIO_ROOT_PASSWORD=societe-minio-dev
MINIO_BUCKET=societe-local
# Both buckets are private. Reads are short-lived signed URLs only.
MEDIA_QUARANTINE_BUCKET=societe-quarantine
MEDIA_PROCESSED_BUCKET=societe-processed

# Media ingestion (Phase 3)
MEDIA_UPLOAD_INTENT_TTL_SECONDS=900
MEDIA_PRESIGNED_PUT_TTL_SECONDS=900
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=12000000
MEDIA_MAX_VIDEO_BYTES=40000000
MEDIA_MAX_VIDEO_DURATION_MS=15000
MEDIA_MAX_IMAGE_DIMENSION=8192
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_CAPTION_MAX_LENGTH=300
MEDIA_MAX_VIBE_TAGS=10
MEDIA_VIBE_TAG_MAX_LENGTH=30
MEDIA_UPLOAD_RATE_LIMIT_PER_USER_PER_HOUR=20
MEDIA_UPLOAD_RATE_LIMIT_PER_USER_PER_VENUE_PER_HOUR=10
MEDIA_PENDING_INTENT_LIMIT_PER_USER=3

# Processing. ffmpeg/ffprobe are system binaries baked into the API image.
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe
MEDIA_FFMPEG_TIMEOUT_SECONDS=90
MEDIA_PROCESSING_MAX_ATTEMPTS=5
MEDIA_PROCESSING_RETRY_BACKOFF_SECONDS=30
MEDIA_WORKER_POLL_INTERVAL_SECONDS=5
MEDIA_WORKER_BATCH_SIZE=5
MEDIA_WORKER_HEARTBEAT_PATH=/tmp/societe-media-processor.heartbeat
MEDIA_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# noop/fake are development-only. Startup FAILS if either is set when APP_ENV is
# staging or production: unscanned or unmoderated media must never be publishable.
MEDIA_MALWARE_SCANNER=noop
MEDIA_MODERATION_PROVIDER=fake
MEDIA_MODERATION_POLICY_VERSION=phase3-v1

# Live Vibe publication window and retention
VIBE_EXPIRY_LOCAL_HOUR=6
VIBE_ABSOLUTE_MAX_LIFETIME_HOURS=12
# 0 disables report-driven auto-hide. One report must not be a takedown button.
VIBE_REPORT_AUTO_HIDE_THRESHOLD=0
VIBE_REPORT_DESCRIPTION_MAX_LENGTH=500
VIBE_REPORT_RATE_LIMIT_PER_USER_PER_HOUR=20
VIBE_FEED_PAGE_MAX=30
RETENTION_INCOMPLETE_UPLOAD_HOURS=24
RETENTION_PROCESSED_ORIGINAL_HOURS=24
RETENTION_REJECTED_ORIGINAL_DAYS=3
RETENTION_PROCESSED_DERIVATIVE_DAYS=7

# Calling Cards (Phase 4)
CALLING_CARD_TTL_SECONDS=1800
DECLINE_COOLDOWN_SECONDS=7200
CALLING_CARD_RATE_LIMIT_PER_USER_PER_10_MINUTES=3
CALLING_CARD_RATE_LIMIT_PER_USER_PER_VENUE_NIGHT=10
SENSITIVE_ACTION_LEASE_MIN_REMAINING_SECONDS=30
DISCOVERABLE_LIST_LIMIT=50
REALTIME_PROVIDER=local
PUSH_PROVIDER=local
# Local WS is hosted by the API at WS /v1/realtime/ws (no separate hub service).
REALTIME_ACK_WAIT_SECONDS=2
REALTIME_ACK_TTL_SECONDS=300
EVENT_DISPATCHER_POLL_INTERVAL_SECONDS=2
EVENT_DISPATCHER_BATCH_SIZE=20
EVENT_DISPATCHER_MAX_ATTEMPTS=12
EVENT_DISPATCHER_RETRY_BACKOFF_SECONDS=5
EVENT_DISPATCHER_HEARTBEAT_PATH=/tmp/societe-event-dispatcher.heartbeat
EVENT_DISPATCHER_HEARTBEAT_MAX_AGE_SECONDS=120

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025

OTEL_ENABLED=false
OTEL_SERVICE_NAME=societe-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags (Phase 0 defaults)
FF_LIVE_CROWD_COUNTS=false
FF_CALLING_CARDS=false
FF_VENUE_PEOPLE_DISCOVERY=false
FF_QR_VERIFICATION=false
FF_BLE_VERIFICATION=false
FF_MEDIA_POSTING=true
FF_AUTOMATED_MODERATION=false
FF_GHOST_MODE=true
# Enables POST /v1/dev/location/simulate. Startup fails if APP_ENV is not
# development or test, because the simulator bypasses mock-location rejection.
FF_LOCATION_SIMULATOR=false

# Pinned local dependency images (documented in docs/dependency-upgrades.md)
POSTGRES_IMAGE=postgis/postgis:16-3.5
VALKEY_IMAGE=valkey/valkey:8.1.9
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MAILPIT_IMAGE=axllent/mailpit:v1.30.5
API_PYTHON_IMAGE=python:3.12.13-slim-bookworm
