    "/v1/auth/local/token": {
      "post": {
        "description": "Mint a local JWT for development/test only.\n\nDoes not accept arbitrary credentials. Subject and handle come from server config.\nDisabled unless AUTH_PROVIDER=local and APP_ENV is development or test.",
        "operationId": "issue_local_dev_token_v1_auth_local_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LocalDevTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": " Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Issue Local Dev Token V1 Auth Local Token Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Local Dev Token",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/me": {
